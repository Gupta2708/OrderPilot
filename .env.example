# Local development credentials only. Copy this file to .env in the repository root.
POSTGRES_USER=orderpilot
POSTGRES_PASSWORD=orderpilot_dev
POSTGRES_DB=orderpilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://orderpilot:orderpilot_dev@127.0.0.1:5432/orderpilot
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=orderpilot
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Agent runtime. "mock" needs no API key and gives deterministic demo behaviour.
LLM_PROVIDER=mock
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
